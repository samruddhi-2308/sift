{
  "name": "sift-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "crawler:start": "pnpm --filter @sift/crawler start",
    "crawler:seed": "pnpm --filter @sift/crawler seed",
    "dlq:replay": "pnpm --filter @sift/crawler dlq:replay",
    "audit:robots": "pnpm --filter @sift/crawler cli audit-robots"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
