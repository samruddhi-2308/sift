# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Service URLs
PORT=3000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sift
MONGODB_DB_NAME=sift

# Redis (Redis Stack with RedisBloom)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sift_chunks

# Embeddings API Keys (at least one or local fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Crawler Defaults
CRAWLER_CONCURRENCY=5
CRAWLER_DEFAULT_DELAY_MS=1000
CRAWLER_USER_AGENT=SiftBot/1.0 (+https://github.com/sift-search/sift)
MAX_PAGE_SIZE_BYTES=2097152
